# build outputs
build/
build-*/
build.log
.pio/
managed_components/
sdkconfig.old
dependencies.lock.bak
__pycache__/

# secrets (API keys, Wi-Fi passwords) never go to git
secrets.h
secrets.json
*.secret

# flash dumps are large binaries; kept locally in backups/
backups/*.bin

# release archives (tools/release.ps1): binaries stay local, the manifest, checksums and
# flash_args are committed
releases/**
!releases/*/
!releases/*/manifest.json
!releases/*/SHA256SUMS.txt
!releases/*/flash_args

# editor / OS
.vscode/
*.swp
Thumbs.db
shots/
