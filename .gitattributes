# Normalise text to LF in the repository; Windows scripts keep CRLF in the working tree
* text=auto eol=lf
*.ps1 text eol=crlf
*.bat text eol=crlf
*.cmd text eol=crlf

# Binary files: no diff, no line-ending conversion
*.bin binary
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.webp binary
*.ttf binary
*.otf binary
*.woff binary
*.woff2 binary
*.wav binary
*.pdf binary
*.z binary

# GitHub language statistics: generated fonts and vendored reference code are not "our" C
main/ui/fonts/*.c linguist-generated=true
third_party/** linguist-vendored=true
docs/research/*.json linguist-documentation=true
