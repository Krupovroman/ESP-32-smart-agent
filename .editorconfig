# https://editorconfig.org
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{c,h,inc}]
indent_size = 4
max_line_length = 120

[*.py]
indent_size = 4
max_line_length = 120

[*.{ps1,bat,cmd}]
end_of_line = crlf
indent_size = 4

[*.{json,yml,yaml,toml}]
indent_size = 2

[{CMakeLists.txt,*.cmake}]
indent_size = 4

[*.md]
indent_size = 2
trim_trailing_whitespace = false

# generated by ESP-IDF / the component manager: leave as written
[{sdkconfig,sdkconfig.*,dependencies.lock}]
trim_trailing_whitespace = false

[main/ui/fonts/*.c]
max_line_length = off
